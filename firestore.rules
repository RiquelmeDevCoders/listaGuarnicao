rules_version = '2';

// Escala SD EV — Firestore Security Rules
//
// Modelo:
//   users/{uid}        perfil do militar (nome de guerra, OM, bloqueio)
//   escalas/{AAAA-MM-DD} uma escala por dia: slots (18 vagas) + quem (uid -> vaga)
//   config/admin       uid do aparelho principal do administrador (SD EV RIQUELME)
//   admins/{uid}       outros aparelhos do ADM, liberados com a senha padrão do ADM
//
// Vagas: h1p1 ... h3p3 (1 militar por posto = 9 vagas).
// De 25/10 a 30/10/2026 houve posto duplo (h1p1b ... h3p3b, 18 vagas); essas
// escalas continuam válidas no histórico.
//
// Horário: toda validação de abertura/fechamento usa request.time (relógio do
// servidor Google), nunca o relógio do celular. Brasília = UTC-3 (sem horário
// de verão desde 2019). Se o horário de verão voltar, ajustar OFFSET abaixo.
//
// Janela de preenchimento da escala do dia D:
//   abre  no dia D-1 às 18:00 (seg a sex) ou 16:00 (sáb e dom)
//   fecha no dia D às 00:00 (vira histórico, somente leitura)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function adminPath() {
      return /databases/$(database)/documents/config/admin;
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && me().bloqueado == false;
    }

    function adminDevicePath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    // SHA-256 de 'escala-sd-ev|' + senha do ADM
    function adminPassHash() {
      return '9f69607f94f99bff3bcf2446f0564b25d082dbcbdd5998d64cdc38a869cf763b';
    }

    function isAdmin() {
      return signedIn()
        && (exists(adminDevicePath(request.auth.uid))
            || (exists(adminPath()) && get(adminPath()).data.uid == request.auth.uid));
    }

    function validNome(n) {
      return n is string
        && n.size() >= 2
        && n.size() <= 20
        && n.matches('^[A-ZÁÂÃÀÉÊÍÓÔÕÚÜÇ][A-ZÁÂÃÀÉÊÍÓÔÕÚÜÇ ]*[A-ZÁÂÃÀÉÊÍÓÔÕÚÜÇ]$');
    }

    function validOm(o) {
      return o in ['CIA C', 'PE'];
    }

    function slotKeys() {
      return ['h1p1', 'h1p2', 'h1p3', 'h2p1', 'h2p2', 'h2p3', 'h3p1', 'h3p2', 'h3p3'];
    }

    // Posto duplo valeu para as escalas de 25/10/2026 a 30/10/2026.
    // A partir de 31/10/2026 volta o posto normal: 1 militar por posto (9 vagas).
    // Quem já estava na vaga 2 de uma escala aberta pode continuar ou cancelar.
    function seatKeysFor(dia) {
      return dia >= '2026-10-31' ? slotKeys() : doubleKeys();
    }

    function doubleKeys() {
      return ['h1p1', 'h1p2', 'h1p3', 'h2p1', 'h2p2', 'h2p3', 'h3p1', 'h3p2', 'h3p3',
              'h1p1b', 'h1p2b', 'h1p3b', 'h2p1b', 'h2p2b', 'h2p3b', 'h3p1b', 'h3p2b', 'h3p3b'];
    }

    function sv(s, k) {
      return s.get(k, null);
    }

    function validDia(dia) {
      return dia.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // 00:00 UTC do dia da escala
    function diaUtc(dia) {
      return timestamp.date(int(dia[0:4]), int(dia[5:7]), int(dia[8:10]));
    }

    // 0 = domingo ... 6 = sábado (01/01/1970 foi quinta-feira)
    function weekday(dia) {
      return (int(diaUtc(dia).toMillis() / 86400000) + 4) % 7;
    }

    // Véspera é sábado ou domingo quando a escala é de domingo ou segunda.
    // Abertura: D-1 18:00 BRT = D 00:00 UTC - 3h ; D-1 16:00 BRT = D 00:00 UTC - 5h
    function abertura(dia) {
      return weekday(dia) == 0 || weekday(dia) == 1
        ? diaUtc(dia) - duration.value(5, 'h')
        : diaUtc(dia) - duration.value(3, 'h');
    }

    // Fechamento: D 00:00 BRT = D 00:00 UTC + 3h
    function fechamento(dia) {
      return diaUtc(dia) + duration.value(3, 'h');
    }

    function janelaAberta(dia) {
      return validDia(dia)
        && request.time >= abertura(dia)
        && request.time < fechamento(dia);
    }

    // Regras das vagas.
    // O documento da escala guarda, além das vagas (slots), o índice
    // quem = { uid: vaga } — assim cada verificação olha só UMA vaga e não
    // precisa varrer as 18 (o Firestore limita a 1.000 expressões por pedido).

    function seatOk(v) {
      return v is map
        && v.keys().hasAll(['uid', 'nome', 'om', 'em'])
        && v.keys().hasOnly(['uid', 'nome', 'om', 'em'])
        && v.uid == request.auth.uid
        && v.nome == me().nome
        && v.om == me().om
        && v.em == request.time;
    }

    function validCreate(dia) {
      let d = request.resource.data;
      let q = d.get('quem', {});
      let k = q.get(request.auth.uid, '');
      return d.keys().hasAll(['data', 'createdAt', 'slots', 'quem'])
        && d.keys().hasOnly(['data', 'createdAt', 'slots', 'quem'])
        && d.data == dia
        && d.createdAt == request.time
        && q.keys().hasOnly([request.auth.uid])
        && k in seatKeysFor(dia)
        && d.slots.keys().hasOnly([k])
        && seatOk(d.slots[k]);
    }

    // Escalas criadas antes do índice quem (até 26/10/2026): confere vaga por vaga,
    // a menos que o ADM já tenha completado o índice (quemCompleto).
    function notMine(v) {
      return v == null || v.uid != request.auth.uid;
    }

    function legacyNoneMine(s) {
      return notMine(sv(s, 'h1p1')) && notMine(sv(s, 'h1p2')) && notMine(sv(s, 'h1p3'))
        && notMine(sv(s, 'h2p1')) && notMine(sv(s, 'h2p2')) && notMine(sv(s, 'h2p3'))
        && notMine(sv(s, 'h3p1')) && notMine(sv(s, 'h3p2')) && notMine(sv(s, 'h3p3'))
        && notMine(sv(s, 'h1p1b')) && notMine(sv(s, 'h1p2b')) && notMine(sv(s, 'h1p3b'))
        && notMine(sv(s, 'h2p1b')) && notMine(sv(s, 'h2p2b')) && notMine(sv(s, 'h2p3b'))
        && notMine(sv(s, 'h3p1b')) && notMine(sv(s, 'h3p2b')) && notMine(sv(s, 'h3p3b'));
    }

    // Assumir a vaga k: quem ganha exatamente minha entrada e slots muda só em k
    function validTake(dia) {
      let n = request.resource.data;
      let o = resource.data;
      let oq = o.get('quem', {});
      let nq = n.get('quem', {});
      let k = nq.get(request.auth.uid, '');
      return n.diff(o).affectedKeys().hasOnly(['slots', 'quem'])
        && !(request.auth.uid in oq)
        && k in seatKeysFor(dia)
        && nq.diff(oq).affectedKeys().hasOnly([request.auth.uid])
        && n.slots.diff(o.slots).affectedKeys().hasOnly([k])
        && sv(o.slots, k) == null
        && seatOk(n.slots[k])
        && (dia > '2026-10-26' || o.get('quemCompleto', false) == true || legacyNoneMine(o.slots));
    }

    // Liberar a própria vaga k (registrada no índice quem)
    function validRelease() {
      let n = request.resource.data;
      let o = resource.data;
      let oq = o.get('quem', {});
      let nq = n.get('quem', {});
      let k = oq.get(request.auth.uid, '');
      return n.diff(o).affectedKeys().hasOnly(['slots', 'quem'])
        && k in doubleKeys()
        && !(request.auth.uid in nq)
        && nq.diff(oq).affectedKeys().hasOnly([request.auth.uid])
        && n.slots.diff(o.slots).affectedKeys().hasOnly([k])
        && sv(o.slots, k) != null
        && sv(o.slots, k).uid == request.auth.uid
        && sv(n.slots, k) == null;
    }

    // Liberar vaga em escala antiga, reservada antes do índice quem existir
    function legacyReleaseOk(k) {
      let a = sv(resource.data.slots, k);
      let b = sv(request.resource.data.slots, k);
      return a == b || (a != null && a.uid == request.auth.uid && b == null);
    }

    function validLegacyRelease() {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['slots'])
        && !(request.auth.uid in o.get('quem', {}))
        && n.slots.diff(o.slots).affectedKeys().size() == 1
        && n.slots.keys().hasOnly(doubleKeys())
        && legacyReleaseOk('h1p1') && legacyReleaseOk('h1p2') && legacyReleaseOk('h1p3')
        && legacyReleaseOk('h2p1') && legacyReleaseOk('h2p2') && legacyReleaseOk('h2p3')
        && legacyReleaseOk('h3p1') && legacyReleaseOk('h3p2') && legacyReleaseOk('h3p3')
        && legacyReleaseOk('h1p1b') && legacyReleaseOk('h1p2b') && legacyReleaseOk('h1p3b')
        && legacyReleaseOk('h2p1b') && legacyReleaseOk('h2p2b') && legacyReleaseOk('h2p3b')
        && legacyReleaseOk('h3p1b') && legacyReleaseOk('h3p2b') && legacyReleaseOk('h3p3b');
    }

    // Administrador: remove militares de vagas e completa o índice quem de escalas antigas
    function validAdminUpdate() {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['slots', 'quem', 'quemCompleto'])
        && n.slots is map
        && n.slots.keys().hasOnly(doubleKeys())
        && n.get('quem', {}) is map;
    }

    function validNewUser(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['nome', 'om', 'createdAt', 'lastSeen', 'bloqueado'])
        && d.keys().hasOnly(['nome', 'om', 'createdAt', 'lastSeen', 'bloqueado'])
        && validNome(d.nome)
        && validOm(d.om)
        && d.createdAt == request.time
        && d.lastSeen == request.time
        && d.bloqueado == false
        && (d.nome != 'RIQUELME'
            || existsAfter(adminDevicePath(uid))
            || getAfter(adminPath()).data.uid == uid);
    }

    function validSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
    }

    function validAdminUserUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['nome', 'om', 'bloqueado'])
        && validNome(d.nome)
        && validOm(d.om)
        && d.bloqueado is bool;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validNewUser(uid);
      allow update: if signedIn()
        && ((request.auth.uid == uid && validSelfUpdate())
            || (isAdmin() && validAdminUserUpdate()));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /config/admin {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.auth.uid)).data.nome == 'RIQUELME';
      allow update, delete: if false;
    }

    // Novo aparelho do ADM: precisa da senha do ADM e do cadastro RIQUELME no mesmo envio.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['prova', 'createdAt'])
        && request.resource.data.keys().hasOnly(['prova', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.prova == adminPassHash()
        && getAfter(userPath(uid)).data.nome == 'RIQUELME';
      allow update, delete: if false;
    }

    // Registro de erros dos militares, para o ADM investigar problemas
    match /erros/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'nome', 'acao', 'codigo', 'detalhe', 'escala', 'versao', 'em'])
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'acao', 'codigo', 'detalhe', 'escala', 'versao', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 20
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 40
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 60
        && request.resource.data.detalhe is string && request.resource.data.detalhe.size() <= 300
        && request.resource.data.escala is string && request.resource.data.escala.size() <= 10
        && request.resource.data.versao is string && request.resource.data.versao.size() <= 10
        && request.resource.data.em == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Marcador de versão das regras: o app confere se estas regras foram publicadas
    match /meta/regras-2-3 {
      allow get: if signedIn();
      allow write: if false;
    }

    match /escalas/{dia} {
      allow read: if hasProfile();
      allow create: if activeUser() && janelaAberta(dia) && validCreate(dia);
      allow update: if (activeUser() && janelaAberta(dia)
          && (validTake(dia) || validRelease() || validLegacyRelease()))
        || (isAdmin() && validAdminUpdate());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
